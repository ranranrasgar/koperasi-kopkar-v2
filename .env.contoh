# Salin menjadi .env (di folder yang sama dengan docker-compose.yml) lalu isi. .env tidak ikut git.

# Sandi database PostgreSQL di container db. Ganti dengan sandi acak panjang (mis. openssl rand -base64 32 | tr -d '/+=').
DB_PASSWORD=

# Folder cadangan di host; terlihat sebagai /backup di container admin.
BACKUP_DIR=/var/backups/kopkar

# Image aplikasi; kosong = ghcr.io/ranranrasgar/koperasi-kopkar-v2:latest (dibuat GitHub Actions).
# Isi tag commit lama (ghcr.io/ranranrasgar/koperasi-kopkar-v2:a1b2c3d) untuk kembali ke versi sebelumnya.
KOPKAR_IMAGE=

# Hanya untuk build sendiri (docker compose build); image dari GitHub sudah membawa commit-nya.
KOPKAR_COMMIT=
