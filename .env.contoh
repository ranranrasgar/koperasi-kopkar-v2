# Salin menjadi .env (di folder yang sama dengan docker-compose.yml) lalu isi. .env tidak ikut git.

# Sandi database PostgreSQL di container db. Ganti dengan sandi acak panjang (mis. openssl rand -base64 32 | tr -d '/+=').
DB_PASSWORD=

# Folder cadangan di host; terlihat sebagai /backup di container admin.
BACKUP_DIR=/var/backups/kopkar

# Diisi otomatis oleh perintah build di docs/DEPLOY-VPS.md (commit aplikasi yang dicatat di manifest cadangan).
KOPKAR_COMMIT=
