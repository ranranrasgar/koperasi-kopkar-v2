{
    "name": "kopkar-v2",
    "private": true,
    "type": "module",
    "workspaces": ["backend", "mobile-api", "frontend", "anggota"],
    "scripts": {
        "dev": "npm run dev -w frontend",
        "dev:uji": "npm run dev:uji -w frontend",
        "dev:anggota": "npm run dev -w anggota",
        "dev:anggota:uji": "npm run dev:uji -w anggota",
        "uji:reset": "node database/postgres/uji-reset.mjs",
        "backup": "node database/postgres/backup.mjs",
        "restore": "node database/postgres/restore.mjs",
        "panduan:pasang": "node database/postgres/panduan-pasang.mjs",
        "pengaturan:pasang": "node database/postgres/pengaturan-pasang.mjs",
        "email:uji": "node backend/scripts/email-uji.mjs",
        "email:sandi": "node backend/scripts/email-atur.mjs",
        "anggota:pasang": "node database/postgres/anggota-pasang.mjs",
        "test": "npm run test -w backend && npm run test -w mobile-api"
    }
}
