<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/layoutFooter"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Logo -->
            <View
                android:id="@+id/logoBg"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="16dp" />

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginTop="-65dp"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="KopkarMJS2000"
                android:textColor="@color/design_text_dark"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Portal Anggota Koperasi"
                android:textColor="@color/design_text_gray"
                android:textSize="14sp" />

            <!-- Form Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="vertical">

                <!-- Username -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Username / ID Anggota"
                    android:textColor="@color/design_text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editName"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_modern"
                    android:drawableStart="@drawable/ic_username"
                    android:drawablePadding="12dp"
                    android:hint="Masukkan ID / Username Anda"
                    android:paddingHorizontal="16dp"
                    android:singleLine="true"
                    android:textColor="@color/design_text_dark"
                    android:textColorHint="#A0B0BCC7"
                    android:textSize="14sp" />

                <!-- Password Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kata Sandi"
                        android:textColor="@color/design_text_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvwLupaPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:onClick="onClickLupaPassword"
                        android:text="Lupa Password?"
                        android:textColor="@color/design_blue_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <EditText
                    android:id="@+id/editPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:autofillHints="none"
                    android:background="@drawable/bg_input_modern"
                    android:drawableStart="@drawable/ic_password"
                    android:drawableEnd="@drawable/ic_passoff"
                    android:drawablePadding="12dp"
                    android:hint="Masukkan Password"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/design_text_dark"
                    android:textColorHint="#A0B0BCC7"
                    android:textSize="14sp" />

                <!-- Optional Registration Fields -->
                <EditText
                    android:id="@+id/editPassword2"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:autofillHints="none"
                    android:background="@drawable/bg_input_modern"
                    android:drawableStart="@drawable/ic_password"
                    android:drawablePadding="12dp"
                    android:hint="Konfirmasi Password Baru"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/design_text_dark"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/editNIK"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input_modern"
                    android:drawableStart="@drawable/ic_nik"
                    android:drawablePadding="12dp"
                    android:hint="Nomor NIK"
                    android:inputType="number"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/design_text_dark"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <Spinner
                    android:id="@+id/spinPertanyaan"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input_modern"
                    android:paddingHorizontal="12dp"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/editJawaban"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input_modern"
                    android:drawableStart="@drawable/ic_jawaban"
                    android:drawablePadding="12dp"
                    android:hint="Jawaban Pertanyaan Keamanan"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/design_text_dark"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <!-- Single Primary Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSignIn"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="28dp"
                    android:backgroundTint="@color/design_blue_dark"
                    android:text="Masuk"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp"
                    app:icon="@drawable/ic_login_arrow"
                    app:iconGravity="textEnd"
                    app:iconPadding="8dp" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <!-- Secondary Options (Text Links) -->
                <LinearLayout
                    android:id="@+id/layoutRegisterPrompt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvRegisterPromptLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Belum punya akun?"
                        android:textColor="@color/design_text_gray"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnRegister"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="4dp"
                        android:text="Daftar Sekarang"
                        android:textColor="@color/design_blue_dark"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Back to Login Text Button (Visible in Register Mode) -->
                <TextView
                    android:id="@+id/btnBackToLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_arrow_back_blue"
                    android:drawablePadding="8dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="Sudah Punya Akun? Kembali ke Login"
                    android:textColor="@color/design_blue_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Security Question Reset Link -->
                <TextView
                    android:id="@+id/btnSecurityReset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:text="Reset via Pertanyaan Keamanan"
                    android:textColor="@color/design_text_gray"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Footer -->
    <LinearLayout
        android:id="@+id/layoutFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_security_green"
                app:tint="@color/design_text_gray" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Koneksi Terenkripsi SSL Aman"
                android:textColor="@color/design_text_gray"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="© 2026 Portal Koperasi KopkarMJS2000"
            android:textColor="@color/design_text_gray"
            android:textSize="11sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>