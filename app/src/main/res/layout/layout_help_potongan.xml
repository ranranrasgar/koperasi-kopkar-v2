<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_rounded_white"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="#E5E7EB" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Informasi Perhitungan"
        android:textColor="@color/design_blue_dark"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Berikut adalah detail cara sistem menghitung potongan bulanan Anda:"
        android:textColor="@color/design_text_gray"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="20dp"
        android:background="#F3F4F6" />

    <!-- Rumus Pinjaman -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Angsuran Pinjaman"
            android:textColor="@color/design_text_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#F9FAFB"
            android:padding="12dp"
            android:text="Angsuran = (Pokok - UM) / Tenor + Bunga Bulanan"
            android:textColor="@color/design_blue_dark"
            android:fontFamily="monospace"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="• Pokok: Nilai total pinjaman\n• UM: Uang muka yang sudah dibayar\n• Tenor: Jangka waktu angsuran (bulan)\n• Bunga: Dihitung secara flat berdasarkan persentase per periode."
            android:textColor="@color/design_text_gray"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>

    <!-- Simpanan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. Simpanan Koperasi"
            android:textColor="@color/design_text_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Potongan rutin sesuai kesepakatan anggota untuk Simpanan Wajib dan Sukarela (jika ada)."
            android:textColor="@color/design_text_gray"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Adm Bank -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3. Biaya Admin Bank"
            android:textColor="@color/design_text_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Biaya tetap administrasi perbankan untuk proses transfer payroll sebesar Rp 2.000."
            android:textColor="@color/design_text_gray"
            android:textSize="13sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUnderstood"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:text="Saya Mengerti"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        app:backgroundTint="@color/design_blue_dark"
        app:cornerRadius="12dp" />

</LinearLayout>
