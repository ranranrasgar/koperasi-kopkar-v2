<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#E5E7EB"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvBulanKe"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_blue_light"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/design_blue_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTanggal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Tgl Tagihan: 12 Jul 2023"
            android:textColor="@color/design_text_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tvAmount"
            app:layout_constraintStart_toEndOf="@id/tvBulanKe"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTglBayar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tgl Bayar: -"
            android:textColor="@color/design_text_gray"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="@id/tvTanggal"
            app:layout_constraintStart_toStartOf="@id/tvTanggal"
            app:layout_constraintTop_toBottomOf="@id/tvTanggal" />

        <TextView
            android:id="@+id/tvRincian"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Pokok: Rp 0 | Jasa: Rp 0"
            android:textColor="@color/design_text_gray"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="@id/tvTanggal"
            app:layout_constraintStart_toStartOf="@id/tvTanggal"
            app:layout_constraintTop_toBottomOf="@id/tvTglBayar" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_secure_pill"
            android:backgroundTint="#F3F4F6"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="Belum Dibayar"
            android:textColor="#6B7280"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tvTanggal"
            app:layout_constraintTop_toBottomOf="@id/tvRincian" />

        <TextView
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 0"
            android:textColor="@color/design_text_dark"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
